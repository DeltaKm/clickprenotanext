// Prisma schema for MongoDB multi-tenant booking system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT & USER MODELS
// ============================================

model Tenant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  name      String
  domain    String?
  settings  Json?
  isActive  Boolean  @default(true)
  
  // Booking form customization
  brandColor     String? @default("#2563eb")
  logo           String?
  welcomeMessage String?
  
  // License info (managed by Admin)
  adminId       String?   @db.ObjectId // Which admin manages this tenant
  expiresAt     DateTime? // When this tenant's license expires
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users        User[]
  staff        Staff[]
  services     Service[]
  customers    Customer[]
  appointments Appointment[]
  coupons      Coupon[]
  taxRules     TaxRule[]
  workingHours WorkingHours[]
  staffServices StaffService[]

  @@map("tenants")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OWNER
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  email        String
  passwordHash String
  role         UserRole @default(CUSTOMER)
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff           Staff?
  licensePackages LicensePackage[]  // Admin's license packages

  @@unique([tenantId, email])
  @@map("users")
}

// License packages for Admins
model LicensePackage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId         String   @db.ObjectId
  quantity        Int      // Total licenses in this package
  used            Int      @default(0) // How many are used
  durationMonths  Int      // Duration in months (e.g., 12 for 1 year)
  createdAt       DateTime @default(now())
  
  // Relations
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("license_packages")
}

// ============================================
// STAFF & WORKING HOURS
// ============================================

model Staff {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  userId    String   @unique @db.ObjectId
  bio       String?
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingHours  WorkingHours[]
  appointments  Appointment[]
  staffServices StaffService[]

  @@unique([tenantId, userId])
  @@index([tenantId, isActive])
  @@map("staff")
}

model WorkingHours {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String  @db.ObjectId
  staffId    String  @db.ObjectId
  dayOfWeek  Int // 0 = Sunday, 6 = Saturday
  startTime  String // Format: "HH:mm" (e.g., "09:00")
  endTime    String // Format: "HH:mm" (e.g., "17:00")
  breakStart String? // Format: "HH:mm"
  breakEnd   String? // Format: "HH:mm"
  isActive   Boolean @default(true)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, staffId, dayOfWeek])
  @@map("working_hours")
}

// ============================================
// SERVICES
// ============================================

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String   @db.ObjectId
  name        String
  description String?
  duration    Int // Duration in minutes
  price       Float
  currency    String   @default("EUR")
  isActive    Boolean  @default(true)
  
  // Availability settings
  availableDays String[] @default(["1", "2", "3", "4", "5"]) // 0=Sunday, 1=Monday, etc.
  startTime     String   @default("09:00") // Format: "HH:mm"
  endTime       String   @default("18:00") // Format: "HH:mm"
  slotDuration  Int      @default(30) // Minutes per slot
  closedDates   Json     @default("[]") // Array of {date: "YYYY-MM-DD", reason: "string"}
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  staffServices StaffService[]

  @@index([tenantId, isActive])
  @@map("services")
}

model StaffService {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String @db.ObjectId
  staffId   String @db.ObjectId
  serviceId String @db.ObjectId

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([tenantId, staffId])
  @@index([tenantId, serviceId])
  @@map("staff_services")
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  email     String
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, email])
  @@map("customers")
}

// ============================================
// APPOINTMENTS
// ============================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  tenantId   String            @db.ObjectId
  customerId String            @db.ObjectId
  staffId    String?           @db.ObjectId
  serviceId  String            @db.ObjectId
  startTime  DateTime
  endTime    DateTime
  status     AppointmentStatus @default(PENDING)
  notes      String?
  totalPrice Float
  couponId   String?           @db.ObjectId
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  coupon   Coupon?  @relation(fields: [couponId], references: [id])

  @@index([tenantId, startTime])
  @@index([tenantId, staffId, startTime])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("appointments")
}

// ============================================
// COUPONS & TAX
// ============================================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId      String       @db.ObjectId
  code          String
  discountType  DiscountType
  discountValue Float
  validFrom     DateTime
  validTo       DateTime
  maxUses       Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, code])
  @@map("coupons")
}

model TaxRule {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  name      String
  rate      Float // Percentage (e.g., 22 for 22%)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("tax_rules")
}
